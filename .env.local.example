# ─── Required by the web app ────────────────────────────────────────────────

# Postgres connection string.
# Local dev:  postgresql://localhost:5432/trackai_dev
# Production: the POOLED Neon connection string (the one with "-pooler" in the
# host). Serverless functions open many short-lived connections; the pooled
# endpoint is what handles that.
DATABASE_URL="postgresql://localhost:5432/trackai_dev"

# Admin review-queue password, stored as salt:hash (never the password itself).
# Generate with:  npm run hash-password "your-password-here"
ADMIN_PASSWORD_HASH=""

# Signs the admin session cookie, and salts the hashed IPs used for submit-form
# rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Bearer token n8n presents to /api/ingest/*. Generate the same way as above.
# This is the only credential n8n needs — it never gets database access.
INGEST_API_TOKEN=""

# Public origin used to build the signed review links in the digest email.
# Local dev:  http://localhost:3000
# Production: https://trackai.theaugustdispatch.com
PUBLIC_BASE_URL="http://localhost:3000"

# Optional. Comma-separated client IPs allowed to reach /admin at all — any
# other IP gets a bare 404, login page included. Leave empty to allow the
# open internet to the login form (still password + rate-limited). Set it to
# your own IP(s) if they're stable. Find yours at https://ifconfig.me
ADMIN_IP_ALLOWLIST=""


# ─── Set in n8n, NOT here ───────────────────────────────────────────────────
# The workflows in n8n/ read these from the n8n instance's own environment.
# Listed here only so the full set is documented in one place.
#
#   TRACKAI_BASE_URL             https://trackai.theaugustdispatch.com
#   TRACKAI_INGEST_TOKEN         same value as INGEST_API_TOKEN above
#   ANTHROPIC_API_KEY            from console.anthropic.com (usage-billed,
#                                separate from any Claude subscription)
#   TRACKAI_DIGEST_TO            inbox that receives the daily review digest
